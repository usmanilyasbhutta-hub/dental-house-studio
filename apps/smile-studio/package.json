{
  "name": "dental-house-smile-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile smile-design mockup app for Dental House, Sialkot (on-device, offline PWA)",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "models": "node scripts/models.mjs",
    "prebuild": "node scripts/models.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "e2e": "node scripts/models.mjs && node e2e/run.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
