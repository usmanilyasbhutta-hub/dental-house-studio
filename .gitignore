node_modules/
out/
qc/
.DS_Store
*.log
# Patient material never goes into git
assets/cases/*
!assets/cases/README.md
public/cases/*
!public/cases/demo-case/

# Reference videos (may contain patients) and their analysis frames
references/*
!references/README.md
.cache/

# Clinic footage (large; processed copies are rebuilt by scripts/prep_footage.py)
public/footage/*

# Clinical 3D animations: real case photographs and anything rendered over them stay out of git
clinical-3d/*/assets/before.jpg
clinical-3d/*/assets/after.jpg
clinical-3d/*/checks/
clinical-3d/*/reference_photos/
clinical-3d/*/Reference_vs_Model_*.jpg
clinical-3d/*/assets/gel_volume.png
__pycache__/
# Regenerable from the Blender build (--generic): unbranded instrument renders and the GLB build folder (copied to public/models/)
clinical-3d/*/assets_generic/
clinical-3d/*/glb/
